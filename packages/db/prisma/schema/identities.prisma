/// BE-002 — customer identity. 1:1 with auth.users.id (SQL FK, not a Prisma model).
/// OQ-3: no DOB / health / emergency contact. #344 adds non-sensitive display and
/// preference data only (first/last name, nickname, avatar, roster opt-out,
/// onboarding timestamps, share-link attribution).
model Profile {
  id            String   @id @db.Uuid
  /// #344 — required on write (app validation). Non-blank DB check.
  firstName     String
  /// #344 — required on write (app validation). `""` exists only for the backfill
  /// of single-word legacy names.
  lastName      String   @default("")
  /// DEPRECATED (#344). Derived `trim(firstName || ' ' || lastName)` by the
  /// `profiles_sync_full_name` trigger; never write it directly. Removed in a follow-up.
  fullName      String   @default("")
  email         String
  contactNumber String   @default("")
  /// #344 — optional public display name. 2–30 chars after trim (DB check).
  nickname      String?
  /// #344 — object key in the private `avatars` bucket: `avatars/<profileId>/<cuid>.webp`
  /// (DB check enforces the owner prefix). Served only through short-lived signed URLs.
  avatarKey     String?
  /// #344 — when false the customer is counted but not listed on public rosters (#345).
  showOnPublicRoster Boolean @default(true)
  /// #344 — short URL-safe share code (8 chars, Crockford base32). Generated by the
  /// database on insert; not derived from email or id. Not customer-writable.
  referralCode  String   @unique @default(dbgenerated("app_private.generate_referral_code()"))
  /// #344 — set once at sign-up by `handle_new_user` from metadata `ref`. Not customer-writable.
  referredById  String?  @db.Uuid
  /// #344 — set once at sign-up from metadata `ref_channel`. Not customer-writable.
  referralChannel ReferralChannel?
  onboardingCompletedAt DateTime? @db.Timestamptz
  onboardingSkippedAt   DateTime? @db.Timestamptz
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referredBy              Profile?                  @relation("ProfileReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               Profile[]                 @relation("ProfileReferrals")
  onboarding              ProfileOnboarding?
  staffMember             StaffMember?
  bookings                Booking[]
  policyAcceptances       BookingPolicyAcceptance[]
  waitlistEntries         WaitlistEntry[]
  cancellationRequests    CancellationRequest[]
  rescheduleRequests      RescheduleRequest[]
  bundleAcquisitions      BundleAcquisition[]
  customerBundles         CustomerBundle[]
  pendingUploads          PendingUpload[]

  @@index([email])
  @@index([referredById])
  @@index([onboardingCompletedAt])
  @@map("profiles")
}

/// BE-003 — admin authorisation. Rate/report access derives from `roleId`
/// (StaffRoleDefinition + permissions), not the leftover `role` enum.
/// Only Super Admin / `coach_rates.*` / report keys reach compensation and
/// financial reports. BE-055 — optional 1:1 coach capability (`coach`);
/// not a StaffRole value and not an authorization role.
model StaffMember {
  id        String      @id @default(cuid())
  userId    String      @unique @db.Uuid
  name      String
  email     String
  /// Leftover BE-001 enum. Not authorization truth. Contract drop is a later wave.
  role      StaffRole   @default(ADMIN)
  /// Defaults to Super Admin so pre-#292 writers stay valid. Authorization still reads this FK.
  roleId    String      @default("role_super_admin")
  status    StaffStatus @default(ACTIVE)
  /// When true this row is the system actor for jobs (hold expiry, promotion).
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  profile               Profile                  @relation(fields: [userId], references: [id])
  roleDefinition        StaffRoleDefinition      @relation(fields: [roleId], references: [id])
  /// Teaching profile when this staff member is also a coach (derived `isCoach`).
  coach                 Coach?
  reviewedPayments      Payment[]                @relation("PaymentReviewedBy")
  refundsMarkedPending  Refund[]                 @relation("RefundMarkedPendingBy")
  refundsMarkedRefunded Refund[]                 @relation("RefundMarkedRefundedBy")
  resolvedCancellations CancellationRequest[]    @relation("CancellationResolvedBy")
  resolvedReschedules   RescheduleRequest[]      @relation("RescheduleResolvedBy")
  checkIns              Booking[]                @relation("BookingCheckedInBy")
  noShows               Booking[]                @relation("BookingNoShowBy")
  auditEvents           AuditEvent[]
  pendingUploads        PendingUpload[]
  grantedBundles        BundleAcquisition[]      @relation("BundleGrantedBy")
  reviewedAcquisitions  BundleAcquisition[]      @relation("BundleAcquisitionReviewedBy")
  reviewedBundlePayments BundleAcquisitionPayment[] @relation("BundlePaymentReviewedBy")
  revokedBundles        CustomerBundle[]         @relation("CustomerBundleRevokedBy")

  @@index([status])
  @@index([email])
  @@index([roleId])
  @@map("staff_members")
}

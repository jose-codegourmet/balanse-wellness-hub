/// BE-002 — customer identity. 1:1 with auth.users.id (SQL FK, not a Prisma model).
/// OQ-3: only full name, email, contact number. No DOB / health / emergency contact.
model Profile {
  id            String   @id @db.Uuid
  fullName      String
  email         String
  contactNumber String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staffMember             StaffMember?
  bookings                Booking[]
  policyAcceptances       BookingPolicyAcceptance[]
  waitlistEntries         WaitlistEntry[]
  cancellationRequests    CancellationRequest[]
  rescheduleRequests      RescheduleRequest[]
  bundleAcquisitions      BundleAcquisition[]
  customerBundles         CustomerBundle[]

  @@index([email])
  @@map("profiles")
}

/// BE-003 — admin authorisation. Rate/report access derives from `roleId`
/// (StaffRoleDefinition + permissions), not the leftover `role` enum.
/// Only Super Admin / `coach_rates.*` / report keys reach compensation and
/// financial reports. BE-055 — optional 1:1 coach capability (`coach`);
/// not a StaffRole value and not an authorization role.
model StaffMember {
  id        String      @id @default(cuid())
  userId    String      @unique @db.Uuid
  name      String
  email     String
  /// Leftover BE-001 enum. Not authorization truth. Contract drop is a later wave.
  role      StaffRole   @default(ADMIN)
  /// Defaults to Super Admin so pre-#292 writers stay valid. Authorization still reads this FK.
  roleId    String      @default("role_super_admin")
  status    StaffStatus @default(ACTIVE)
  /// When true this row is the system actor for jobs (hold expiry, promotion).
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  profile               Profile                  @relation(fields: [userId], references: [id])
  roleDefinition        StaffRoleDefinition      @relation(fields: [roleId], references: [id])
  /// Teaching profile when this staff member is also a coach (derived `isCoach`).
  coach                 Coach?
  reviewedPayments      Payment[]                @relation("PaymentReviewedBy")
  refundsMarkedPending  Refund[]                 @relation("RefundMarkedPendingBy")
  refundsMarkedRefunded Refund[]                 @relation("RefundMarkedRefundedBy")
  resolvedCancellations CancellationRequest[]    @relation("CancellationResolvedBy")
  resolvedReschedules   RescheduleRequest[]      @relation("RescheduleResolvedBy")
  checkIns              Booking[]                @relation("BookingCheckedInBy")
  noShows               Booking[]                @relation("BookingNoShowBy")
  auditEvents           AuditEvent[]
  pendingUploads        PendingUpload[]
  grantedBundles        BundleAcquisition[]      @relation("BundleGrantedBy")
  reviewedAcquisitions  BundleAcquisition[]      @relation("BundleAcquisitionReviewedBy")
  reviewedBundlePayments BundleAcquisitionPayment[] @relation("BundlePaymentReviewedBy")
  revokedBundles        CustomerBundle[]         @relation("CustomerBundleRevokedBy")

  @@index([status])
  @@index([email])
  @@index([roleId])
  @@map("staff_members")
}

/// BE-007 — versioned policy documents. Do not invent legal text (OQ-4 / R65).
model PolicyDocument {
  id        String             @id @default(cuid())
  kind      PolicyDocumentKind
  slug      String             @unique
  title     String
  required  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  versions PolicyDocumentVersion[]

  @@map("policy_documents")
}

model PolicyDocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  version       String
  title         String
  body          String
  effectiveFrom DateTime @db.Timestamptz
  isCurrent     Boolean  @default(false)
  isPlaceholder Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document    PolicyDocument            @relation(fields: [documentId], references: [id])
  acceptances BookingPolicyAcceptance[]

  @@unique([documentId, version])
  @@index([documentId, isCurrent])
  @@map("policy_document_versions")
}

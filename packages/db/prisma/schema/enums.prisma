/// BE-001 — shared vocabulary. Values match docs/screen-specs/shared/02-status-language.md
/// unless documented as internal-only in docs/backend/enum-vocabulary.md.
/// COMPLETED is defined but has no transition (OQ-10).

enum BookingStatus {
  WAITLISTED
  HELD_AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  CANCELLATION_REQUESTED
  RESCHEDULE_REQUESTED
  CANCELLED
  REJECTED
  EXPIRED
  CHECKED_IN
  COMPLETED
  NO_SHOW

  @@map("booking_status")
}

enum PaymentMethod {
  GCASH
  PAY_AT_COUNTER

  @@map("payment_method")
}

enum PaymentStatus {
  NONE
  PROOF_SUBMITTED
  CASH_RECEIVED
  VERIFIED
  REJECTED

  @@map("payment_status")
}

enum RefundStatus {
  NOT_APPLICABLE
  REFUND_PENDING

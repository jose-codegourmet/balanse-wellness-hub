  PER_HOUR

  @@map("coach_rate_type")
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("session_status")
}

/// #319 — event publication layer. Distinct from SessionStatus.
/// An event must not be PUBLISHED unless its session is PUBLISHED.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED

  @@map("event_status")
}


/// BE-001 — shared vocabulary. Values match docs/screen-specs/shared/02-status-language.md
/// unless documented as internal-only in docs/backend/enum-vocabulary.md.
/// COMPLETED is defined but has no transition (OQ-10).

enum BookingStatus {
  WAITLISTED
  HELD_AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  CANCELLATION_REQUESTED
  RESCHEDULE_REQUESTED
  CANCELLED
  REJECTED
  EXPIRED
  CHECKED_IN
  COMPLETED
  NO_SHOW

  @@map("booking_status")
}

enum PaymentMethod {
  GCASH
  PAY_AT_COUNTER

  @@map("payment_method")
}

enum PaymentStatus {
  NONE
  PROOF_SUBMITTED
  CASH_RECEIVED
  VERIFIED
  REJECTED

  @@map("payment_status")
}

enum RefundStatus {
  NOT_APPLICABLE
  REFUND_PENDING
  REFUNDED

  @@map("refund_status")
}

enum CoachRateType {
  PER_SESSION
  PER_HOUR

  @@map("coach_rate_type")
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("session_status")
}

/// #319 — event publication layer. Distinct from SessionStatus.
/// An event must not be PUBLISHED unless its session is PUBLISHED.
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED

  @@map("event_status")
}

/// Where a session happens. BRANCH is a studio the business runs;
/// OFFSITE is a partner or one-off place (resort, park).
enum VenueKind {
  BRANCH
  OFFSITE

  @@map("venue_kind")
}

/// Legacy persisted enum. Authorization truth is `StaffRoleDefinition.key`
/// (epic #289 / #298). Do not add FRONT_DESK / COACH here.
enum StaffRole {
  ADMIN

  @@map("staff_role")
}

enum StaffRoleDefinitionStatus {

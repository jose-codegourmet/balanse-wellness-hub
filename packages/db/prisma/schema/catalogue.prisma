/// BE-004 — public profile + internal rate. One photo key (not a collection).
/// BE-055 — optional 1:1 staff link. `isCoach` is derived from this FK, not StaffRole.
model Coach {
  id            String        @id @default(cuid())
  name          String
  specialties   String[]
  shortBio      String        @default("")
  photoKey      String?
  active        Boolean       @default(true)
  defaultRate   Decimal       @db.Decimal(12, 2)
  rateType      CoachRateType
  /// Seed/demo rates are placeholders (OQ-PRICE). Not authoritative.
  isPlaceholder Boolean       @default(false)
  /// Nullable staff capability link. Clearing this must never delete the coach.
  staffMemberId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  staffMember StaffMember?   @relation(fields: [staffMemberId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessions    SessionCoach[]
  marketingClasses ClassMarketingCoach[]

  @@index([active])
  @@index([photoKey])
  @@map("coaches")
}

/// BE-005 — class catalogue. No coach compensation column.
model GymClass {
  id                     String   @id @default(cuid())
  name                   String   @unique
  slug                   String   @unique
  customPageUrl          String?
  description            String   @default("")
  heroImage              String?
  galleryImages          String[] @default([])
  shortDescription       String   @default("")
  defaultDurationMinutes Int?
  defaultCustomerPrice   Decimal? @db.Decimal(12, 2)
  active                 Boolean  @default(true)
  isPlaceholder          Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sessions GymSession[]
  marketingCoaches ClassMarketingCoach[]
  bundleApplicability BundleClassApplicability[]

  @@index([active])
  @@map("classes")
}

/// BE-006 — scheduled session with financial snapshot (never back-written from coach rate).
model GymSession {
  id            String        @id @default(cuid())
  classId       String
  startsAt      DateTime      @db.Timestamptz
  endsAt        DateTime      @db.Timestamptz
  capacity      Int
  status        SessionStatus @default(DRAFT)
  customerPrice Decimal       @db.Decimal(12, 2)
  isPlaceholder Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  recurrenceRuleId String?

  gymClass          GymClass            @relation(fields: [classId], references: [id])
  coaches           SessionCoach[]
  bookings          Booking[]
  waitlistEntries   WaitlistEntry[]
  bundleRedemptions BundleRedemption[]
  rescheduleTargets RescheduleRequest[] @relation("RescheduleTargetSession")
  rescheduleOrigins RescheduleRequest[] @relation("RescheduleFromSession")
  recurrenceRule    SessionRecurrenceRule? @relation("RecurrenceOccurrences", fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  recurrenceTemplates SessionRecurrenceRule[] @relation("RecurrenceTemplate")

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([classId])
  @@index([recurrenceRuleId])
  @@map("sessions")
}

/// #288 — a bounded weekly rule. Occurrences are eagerly generated as ordinary sessions.
model SessionRecurrenceRule {
  id              String   @id @default(cuid())
  sourceSessionId String
  startsOn        DateTime @db.Date
  endsOn          DateTime @db.Date
  weekdays        Int[]
  timeZone        String   @default("Asia/Manila")
  publish         Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceSession GymSession   @relation("RecurrenceTemplate", fields: [sourceSessionId], references: [id], onDelete: Restrict)
  sessions      GymSession[] @relation("RecurrenceOccurrences")

  @@index([sourceSessionId])
  @@index([active, endsOn])
  @@map("session_recurrence_rules")
}

/// BE-053 — public FAQ rows. Display order is `sortOrder`, not document position.
model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("faqs")
}

/// BE-052 — signed-upload intents that must be confirmed or reaped.
model PendingUpload {
  id          String    @id @default(cuid())
  bucket      String
  objectKey   String    @unique
  purpose     String
  entityId    String?
  actorId     String?
  confirmedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  actor StaffMember? @relation(fields: [actorId], references: [id])

  @@index([confirmedAt, createdAt])
  @@index([actorId])
  @@map("pending_uploads")
}

/// At least one teaching assignment per session (enforced by deferred database constraints). Compensation is snapshotted per coach, never per class.
model SessionCoach {
  id            String        @id @default(cuid())
  sessionId     String
  coachId       String
  coachRate     Decimal       @db.Decimal(12, 2)
  coachRateType CoachRateType
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  session GymSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coach   Coach      @relation(fields: [coachId], references: [id])

  @@unique([sessionId, coachId])
  @@index([coachId])
  @@map("session_coaches")
}

/// Optional public marketing roster, independent from SessionCoach staffing.
model ClassMarketingCoach {
  id String @id @default(cuid())
  classId String
  coachId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gymClass GymClass @relation(fields:[classId], references:[id], onDelete:Cascade)
  coach Coach @relation(fields:[coachId], references:[id])
  @@unique([classId,coachId])
  @@index([coachId])
  @@map("class_marketing_coaches")
}

{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": [
      "apps/**/*.{js,ts,jsx,tsx,json}",
      "packages/**/*.{js,ts,jsx,tsx,json}",
      "*.{js,ts,json}",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/dist",
      "!!**/build",
      "!!**/.storybook",
      "!!**/storybook-static",
      "!!**/src/components/jabkit",
      "!!**/.jabkit"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/ui/src/components/**",
        "apps/web/src/stories/**",
        "apps/web/src/hooks/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off",
            "useAriaPropsForRole": "off",
            "noLabelWithoutControl": "off",
            "noSvgWithoutTitle": "off",
            "useKeyWithClickEvents": "off",
            "noRedundantRoles": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off",
            "noDoubleEquals": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "useExhaustiveDependencies": "off"
          }
        }
      }
    }
  ]
}

# Root env — convenience/reference copy. Read by Turbo via globalEnv.
# Per-app runtime values live in apps/*/.env.local; Prisma CLI reads packages/db/.env.
# Copy to .env and fill in your own values: cp .env.example .env
# Never commit real keys. See docs/backend/environment-variables.md.

# Public Supabase API (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://xydundrayuusqizssgby.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Never prefix with NEXT_PUBLIC_. Never commit the real value.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma / Postgres — Balanse project xydundrayuusqizssgby (ap-southeast-1)
# Pooled runtime URL (port 6543). Required query flag: pgbouncer=true
DATABASE_URL="postgresql://postgres.xydundrayuusqizssgby:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL (port 5432) — migrations and Prisma introspection
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xydundrayuusqizssgby.supabase.co:5432/postgres"

# Apps (FE mock phase)
NEXT_PUBLIC_SITE_URL=http://localhost:9000
NEXT_PUBLIC_APP_MODE=mock
NEXT_PUBLIC_ENABLE_MOCK_HARNESS=true
JABKIT_REGISTRY=https://jabkit.joseadrianbuctuanon.dev
